{
  "name": "smartlogistic2",
  "version": "1.0.0",
  "private": true,
  "main": "electron.js",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron-build": "npm run build && electron-builder"
  },

  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "framer-motion": "^11.0.0"
  },

  "devDependencies": {
    "vite": "^5.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.3",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19"
  },

  "build": {
    "appId": "com.smartlogistic.app",
    "productName": "SmartLogistic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
